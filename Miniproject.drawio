        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ClassDiagram_DentCare\ntitle Class Diagram Tong the - DentCare System\nskinparam Style strictuml\nskinparam ClassAttributeIconStyle true\nskinparam Monochrome true\n\nclass Patient {\n\npatientId: String\n\nfullName: String\n\nphone: String\n\ndob: Date\n\ngender: String\n\ngetMedicalHistory(): List\n}\n\nclass Dentist {\n\ndentistId: String\n\nfullName: String\n\nphone: String\n\nspecialization: String\n\ngetSchedule(): List\n}\n\nclass Appointment {\n\nappointmentId: String\n\nappointmentDate: Date\n\ntimeSlot: String\n\nstatus: String\n\ncancel(): Boolean\n\nconfirm(): Boolean\n}\n\nclass MedicalRecord {\n\nrecordId: String\n\ndiagnosis: String\n\nnotes: String\n\ncreatedAt: DateTime\n\naddDetail(): Void\n}\n\nclass DentalService {\n\nserviceId: String\n\nserviceName: String\n\nprice: Double\n\nunit: String\n}\n\nclass Invoice {\n\ninvoiceId: String\n\ncreatedAt: DateTime\n\ntotalAmount: Double\n\npaymentStatus: String\n\ncalculateTotal(): Double\n}\n\nclass InvoiceDetail {\n\ndetailId: String\n\nquantity: Integer\n\nunitPrice: Double\n\nlineTotal: Double\n\ncalculateLineTotal(): Double\n}\n\nabstract class PaymentMethod {\n\npaymentId: String\n\namount: Double\n\npaymentDate: DateTime\n\nprocessPayment(): Boolean\n}\n\nclass CashPayment {\n\ncashReceived: Double\n\nchangeAmount: Double\n}\n\nclass TransferPayment {\n\ntransactionNo: String\n\nbankName: String\n}\n\nPatient \&quot;1\&quot; -- \&quot;0..\&quot; Appointment : makes &gt;\nDentist \&quot;1\&quot; -- \&quot;0..\&quot; Appointment : assigned to &gt;\n\nAppointment \&quot;1\&quot; -- \&quot;0..1\&quot; MedicalRecord : results in &gt;\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; MedicalRecord : has &gt;\n\nMedicalRecord \&quot;1\&quot; -- \&quot;1\&quot; Invoice : generates &gt;\nInvoice \&quot;1\&quot; -- \&quot;1..\&quot; InvoiceDetail : contains &gt;\nDentalService \&quot;1\&quot; -- \&quot;0..*\&quot; InvoiceDetail : referenced in &gt;\n\nInvoice \&quot;1\&quot; -- \&quot;1\&quot; PaymentMethod : paid via &gt;\nPaymentMethod &lt;|-- CashPayment\nPaymentMethod &lt;|-- TransferPayment\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TDuIjm5KejaVBJby8jKj-108">
