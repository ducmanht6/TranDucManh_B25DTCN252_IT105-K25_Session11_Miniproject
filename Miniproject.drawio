        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_DatLichHen\ntitle Sequence Diagram - Dat Lich Hen\nautonumber\nskinparam Style strictuml\nskinparam Monochrome true\n\nactor \&quot;:BenhNhan\&quot; as BN\nparticipant \&quot;:DatLichUI\&quot; as UI\nparticipant \&quot;:AppointmentService\&quot; as AppService\nparticipant \&quot;:DentistService\&quot; as DentService\ndatabase \&quot;:CSDL\&quot; as DB\n\nBN -&gt; UI: Chon Dentist, Ngay, timeSlot\nUI -&gt; AppService: checkAvailability(dentistId, date, timeSlot)\nAppService -&gt; DB: Query Appointment WHERE dentistId, date, timeSlot, status=&#39;CONFIRMED&#39;\nDB --&gt; AppService: Return recordCount\n\nalt [recordCount == 0 (Con slot trong)]\nAppService --&gt; UI: Slot Available\nUI -&gt; AppService: createAppointment(patientId, dentistId, date, timeSlot)\nAppService -&gt; DB: INSERT INTO Appointment (status=&#39;PENDING&#39;)\nDB --&gt; AppService: Success\nAppService --&gt; UI: Appointment Created\nUI --&gt; BN: Hien thi \&quot;Dat lich thanh cong\&quot;\nelse [else (Da co nguoi dat)]\nAppService --&gt; UI: Slot Unavailable\nUI --&gt; BN: Thong bao \&quot;Trung lich\&quot; &amp; Goi y slot khac\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TDuIjm5KejaVBJby8jKj-200">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sequence Diagram - Đặt lịch hẹn" plantUmlId="title_26" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Dat Lich Hen" id="TDuIjm5KejaVBJby8jKj-218">
          <mxCell parent="TDuIjm5KejaVBJby8jKj-200" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="253.69459999999995" x="420.00097857142885" y="2090" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_KhamBenh_HoaDon\ntitle Sequence Diagram - Kham Benh va Tao Hoa Don\nautonumber\nskinparam Style strictuml\nskinparam Monochrome true\n\nactor \&quot;:NhaSi\&quot; as NS\nparticipant \&quot;:KhamBenhUI\&quot; as UI\nparticipant \&quot;:RecordService\&quot; as RecordService\nparticipant \&quot;:InvoiceService\&quot; as InvService\ndatabase \&quot;:CSDL\&quot; as DB\n\nNS -&gt; UI: Nhap Chan doan &amp; Chon danh sach Dich vu\nUI -&gt; RecordService: createMedicalRecord(appointmentId, diagnosis, services)\nRecordService -&gt; DB: INSERT MedicalRecord\nDB --&gt; RecordService: recordId\n\nRecordService -&gt; InvService: generateInvoice(recordId, services)\nInvService -&gt; InvService: self.initInvoice()\n\nloop [cho moi dich vu da thuc hien]\nInvService -&gt; InvService: calculateLineTotal(quantity, price)\nInvService -&gt; DB: INSERT InvoiceDetail\nend\n\nInvService -&gt; InvService: calculateTotalAmount()\nInvService -&gt; DB: INSERT Invoice (totalAmount, status=&#39;UNPAID&#39;)\nDB --&gt; InvService: invoiceId\n\nInvService --&gt; RecordService: Invoice Generated\nRecordService --&gt; UI: Hoan tat Ho so &amp; Hoa don\nUI --&gt; NS: Hien thi ket qua luu thanh cong\n\nopt [Benh nhan yeu cau in hoa don]\nNS -&gt; UI: Yeu cau in\nUI -&gt; InvService: printInvoice(invoiceId)\nInvService --&gt; UI: Render PDF/Print Stream\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TDuIjm5KejaVBJby8jKj-223">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sequence Diagram - Khám bệnh và tạo hóa đơn" plantUmlId="title_35" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Kham Benh va Tao Hoa Don" id="TDuIjm5KejaVBJby8jKj-253">
          <mxCell parent="TDuIjm5KejaVBJby8jKj-223" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="361.92140000000006" x="1703.0797285714286" y="2110" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_HuyLichHen\ntitle Sequence Diagram - Huy Lich Hen\nautonumber\nskinparam Style strictuml\nskinparam Monochrome true\n\nactor \&quot;:BenhNhan\&quot; as BN\nparticipant \&quot;:HuyLichUI\&quot; as UI\nparticipant \&quot;:AppointmentService\&quot; as AppService\ndatabase \&quot;:CSDL\&quot; as DB\n\nBN -&gt; UI: Yeu cau Huy lich (appointmentId)\nUI -&gt; AppService: cancelAppointment(appointmentId)\nAppService -&gt; DB: SELECT status FROM Appointment WHERE id = appointmentId\nDB --&gt; AppService: status\n\nalt [status == \&quot;PENDING\&quot; OR status == \&quot;CONFIRMED\&quot;]\nAppService -&gt; DB: UPDATE Appointment SET status = &#39;CANCELLED&#39;\nDB --&gt; AppService: Success\nAppService --&gt; UI: Cancel Success\nUI --&gt; BN: Thong bao \&quot;Huy lich thanh cong\&quot;\n\nAppService -[se-]-&gt; DB: triggerSMSNotification(dentistId, \&quot;Lich hen da bi huy\&quot;)\nelse [else (status == \&quot;COMPLETED\&quot; hoac khac)]\nAppService --&gt; UI: Cancel Failed\nUI --&gt; BN: Báo lỗi \&quot;Lich hen da kham, khong the huy\&quot;\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TDuIjm5KejaVBJby8jKj-257">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Sequence Diagram - Huy Lich Hen" plantUmlId="title_24" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Huy Lich Hen" id="TDuIjm5KejaVBJby8jKj-276">
