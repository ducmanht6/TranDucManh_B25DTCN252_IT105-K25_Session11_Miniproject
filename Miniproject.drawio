        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UseCase_DentCare\ntitle Use Case Diagram Tong the - DentCare\nleft to right direction\nskinparam Monochrome true\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nactor \&quot;Lễ tân\&quot; as Receptionist\nactor \&quot;Nha sĩ\&quot; as Dentist\nactor \&quot;Quản lý\&quot; as Manager\n\nrectangle \&quot;Hệ thống DentCare\&quot; {\nusecase \&quot;Đặt lịch hẹn\&quot; as UC_Book\nusecase \&quot;Gửi SMS nhắc hẹn\&quot; as UC_SMS\nusecase \&quot;Thanh toán\&quot; as UC_Pay\nusecase \&quot;Tạo hóa đơn\&quot; as UC_Invoice\nusecase \&quot;Đăng ký/Cập nhật BN\&quot; as UC_RegPatient\nusecase \&quot;Khám &amp; Ghi hồ sơ\&quot; as UC_Examine\nusecase \&quot;Xem lịch làm việc\&quot; as UC_Schedule\nusecase \&quot;Quản lý dịch vụ\&quot; as UC_ManageService\nusecase \&quot;Xem báo cáo doanh thu\&quot; as UC_Report\nusecase \&quot;Hủy lịch hẹn\&quot; as UC_Cancel\n}\n\nPatient --&gt; UC_Book\nPatient --&gt; UC_Cancel\n\nReceptionist --&gt; UC_Book\nReceptionist --&gt; UC_Cancel\nReceptionist --&gt; UC_RegPatient\nReceptionist --&gt; UC_Pay\n\nDentist --&gt; UC_Examine\nDentist --&gt; UC_Schedule\n\nManager --&gt; UC_ManageService\nManager --&gt; UC_Report\n\nUC_Book &lt;.. UC_SMS : &lt;&gt;\nUC_Pay ..&gt; UC_Invoice : &lt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TDuIjm5KejaVBJby8jKj-75">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
