<mxfile host="app.diagrams.net">
  <diagram name="Trang-1" id="fcUimrPAGfzmDO541ink">
    <mxGraphModel dx="1654" dy="2018" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;&#39; =========================================================\n&#39; 1. ACTIVITY DIAGRAM - LUỒNG ĐẶT LỊCH HẸN\n&#39; =========================================================\n@startuml Activity_DatLichHen\ntitle Activity Diagram - Luong Dat Lich Hen\nskinparam Style strictuml\nskinparam Monochrome true\n\nstart\n:Benh nhan/Le tan yeu cau dat lich hen;\n:Chon Nha si, Ngay hen va Khung gio (timeSlot);\n\nrepeat\n:He thong kiem tra trang thai khung gio;\nif (Khung gio con trong?) then (Co)\n:Tao lich hen [Trang thai: Cho xac nhan/Da xac nhan];\n:Luu thong tin vao CSDL;\n:Hien thi thong bao Dat lich thanh cong;\nstop\nelse (Khong)\n:He thong hien thi thong bao Trung lich;\n:Goi y cac khung gio con trong khac;\n:Nguoi dung chon Khung gio moi;\nendif\nrepeat while (Xac nhan tiep tuc?) is (Co)\n\n:Huy thao tac dat lich;\nstop\n@enduml\n\n&#39; =========================================================\n&#39; 2. ACTIVITY DIAGRAM - LUỒNG KHÁM BỆNH VÀ THANH TOÁN\n&#39; =========================================================\n@startuml Activity_KhamBenh_ThanhToan\ntitle Activity Diagram - Luong Kham Benh va Thanh Toan\nskinparam Style strictuml\nskinparam Monochrome true\n\n|#LightGray|Benh nhan|\n|#LightYellow|Nha si|\n|#LightCyan|Le tan|\n\n|Benh nhan|\nstart\n:Den phong kham va Check-in;\n\n|Nha si|\n:Kiem tra danh sach lich hen trong ngay;\n:Tien hanh Kham va Chan doan;\n:Ghi nhan Ho so benh an (MedicalRecord);\n:Chon cac Dich vu Nha khoa da thuc hien;\n:Hoan tat ho so va Luu CSDL;\n\n|Le tan|\n:Tiep nhan thong tin hoan tat va Tao Hoa don (Invoice);\n:He thong tu dong tinh Tong tien tu cac dich vu;\n\n|Benh nhan|\n:Nhan thong bao thanh toan va Chon PTTT (Tien mat / Chuyen khoan);\n:Thuc hien thanh toan;\n\n|Le tan|\n:Xac nhan da nhan du tien;\n:Cap nhat trang thai Hoa don -&gt; \&quot;Da thanh toan\&quot;;\nif (Benh nhan yeu cau in hoa don?) then (Co)\n:In hoa don va Ban giao cho Benh nhan;\nelse (Khong)\nendif\n\n|Benh nhan|\n:Nhan hoa don / Ra ve;\nstop\n@enduml\n\n&#39; =========================================================\n&#39; 3. USE CASE DIAGRAM TỔNG THỂ\n&#39; =========================================================\n@startuml UseCase_DentCare\ntitle Use Case Diagram Tong the - DentCare\nleft to right direction\nskinparam Monochrome true\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nactor \&quot;Lễ tân\&quot; as Receptionist\nactor \&quot;Nha sĩ\&quot; as Dentist\nactor \&quot;Quản lý\&quot; as Manager\n\nrectangle \&quot;Hệ thống DentCare\&quot; {\nusecase \&quot;Đặt lịch hẹn\&quot; as UC_Book\nusecase \&quot;Gửi SMS nhắc hẹn\&quot; as UC_SMS\nusecase \&quot;Thanh toán\&quot; as UC_Pay\nusecase \&quot;Tạo hóa đơn\&quot; as UC_Invoice\nusecase \&quot;Đăng ký/Cập nhật BN\&quot; as UC_RegPatient\nusecase \&quot;Khám &amp; Ghi hồ sơ\&quot; as UC_Examine\nusecase \&quot;Xem lịch làm việc\&quot; as UC_Schedule\nusecase \&quot;Quản lý dịch vụ\&quot; as UC_ManageService\nusecase \&quot;Xem báo cáo doanh thu\&quot; as UC_Report\nusecase \&quot;Hủy lịch hẹn\&quot; as UC_Cancel\n}\n\nPatient --&gt; UC_Book\nPatient --&gt; UC_Cancel\n\nReceptionist --&gt; UC_Book\nReceptionist --&gt; UC_Cancel\nReceptionist --&gt; UC_RegPatient\nReceptionist --&gt; UC_Pay\n\nDentist --&gt; UC_Examine\nDentist --&gt; UC_Schedule\n\nManager --&gt; UC_ManageService\nManager --&gt; UC_Report\n\nUC_Book &lt;.. UC_SMS : &lt;&gt;\nUC_Pay ..&gt; UC_Invoice : &lt;&gt;\n@enduml\n\n&#39; =========================================================\n&#39; 4. CLASS DIAGRAM TỔNG THỂ\n&#39; =========================================================\n@startuml ClassDiagram_DentCare\ntitle Class Diagram Tong the - DentCare System\nskinparam Style strictuml\nskinparam ClassAttributeIconStyle true\nskinparam Monochrome true\n\nclass Patient {\n\npatientId: String\n\nfullName: String\n\nphone: String\n\ndob: Date\n\ngender: String\n\ngetMedicalHistory(): List\n}\n\nclass Dentist {\n\ndentistId: String\n\nfullName: String\n\nphone: String\n\nspecialization: String\n\ngetSchedule(): List\n}\n\nclass Appointment {\n\nappointmentId: String\n\nappointmentDate: Date\n\ntimeSlot: String\n\nstatus: String\n\ncancel(): Boolean\n\nconfirm(): Boolean\n}\n\nclass MedicalRecord {\n\nrecordId: String\n\ndiagnosis: String\n\nnotes: String\n\ncreatedAt: DateTime\n\naddDetail(): Void\n}\n\nclass DentalService {\n\nserviceId: String\n\nserviceName: String\n\nprice: Double\n\nunit: String\n}\n\nclass Invoice {\n\ninvoiceId: String\n\ncreatedAt: DateTime\n\ntotalAmount: Double\n\npaymentStatus: String\n\ncalculateTotal(): Double\n}\n\nclass InvoiceDetail {\n\ndetailId: String\n\nquantity: Integer\n\nunitPrice: Double\n\nlineTotal: Double\n\ncalculateLineTotal(): Double\n}\n\nabstract class PaymentMethod {\n\npaymentId: String\n\namount: Double\n\npaymentDate: DateTime\n\nprocessPayment(): Boolean\n}\n\nclass CashPayment {\n\ncashReceived: Double\n\nchangeAmount: Double\n}\n\nclass TransferPayment {\n\ntransactionNo: String\n\nbankName: String\n}\n\nPatient \&quot;1\&quot; -- \&quot;0..\&quot; Appointment : makes &gt;\nDentist \&quot;1\&quot; -- \&quot;0..\&quot; Appointment : assigned to &gt;\n\nAppointment \&quot;1\&quot; -- \&quot;0..1\&quot; MedicalRecord : results in &gt;\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; MedicalRecord : has &gt;\n\nMedicalRecord \&quot;1\&quot; -- \&quot;1\&quot; Invoice : generates &gt;\nInvoice \&quot;1\&quot; -- \&quot;1..\&quot; InvoiceDetail : contains &gt;\nDentalService \&quot;1\&quot; -- \&quot;0..*\&quot; InvoiceDetail : referenced in &gt;\n\nInvoice \&quot;1\&quot; -- \&quot;1\&quot; PaymentMethod : paid via &gt;\nPaymentMethod &lt;|-- CashPayment\nPaymentMethod &lt;|-- TransferPayment\n@enduml\n\n&#39; =========================================================\n&#39; 5. SEQUENCE DIAGRAM - ĐẶT LỊCH HẸN\n&#39; =========================================================\n@startuml Sequence_DatLichHen\ntitle Sequence Diagram - Dat Lich Hen\nautonumber\nskinparam Style strictuml\nskinparam Monochrome true\n\nactor \&quot;:BenhNhan\&quot; as BN\nparticipant \&quot;:DatLichUI\&quot; as UI\nparticipant \&quot;:AppointmentService\&quot; as AppService\nparticipant \&quot;:DentistService\&quot; as DentService\ndatabase \&quot;:CSDL\&quot; as DB\n\nBN -&gt; UI: Chon Dentist, Ngay, timeSlot\nUI -&gt; AppService: checkAvailability(dentistId, date, timeSlot)\nAppService -&gt; DB: Query Appointment WHERE dentistId, date, timeSlot, status=&#39;CONFIRMED&#39;\nDB --&gt; AppService: Return recordCount\n\nalt [recordCount == 0 (Con slot trong)]\nAppService --&gt; UI: Slot Available\nUI -&gt; AppService: createAppointment(patientId, dentistId, date, timeSlot)\nAppService -&gt; DB: INSERT INTO Appointment (status=&#39;PENDING&#39;)\nDB --&gt; AppService: Success\nAppService --&gt; UI: Appointment Created\nUI --&gt; BN: Hien thi \&quot;Dat lich thanh cong\&quot;\nelse [else (Da co nguoi dat)]\nAppService --&gt; UI: Slot Unavailable\nUI --&gt; BN: Thong bao \&quot;Trung lich\&quot; &amp; Goi y slot khac\nend\n@enduml\n\n&#39; =========================================================\n&#39; 6. SEQUENCE DIAGRAM - KHÁM BỆNH VÀ TẠO HÓA ĐƠN\n&#39; =========================================================\n@startuml Sequence_KhamBenh_HoaDon\ntitle Sequence Diagram - Kham Benh va Tao Hoa Don\nautonumber\nskinparam Style strictuml\nskinparam Monochrome true\n\nactor \&quot;:NhaSi\&quot; as NS\nparticipant \&quot;:KhamBenhUI\&quot; as UI\nparticipant \&quot;:RecordService\&quot; as RecordService\nparticipant \&quot;:InvoiceService\&quot; as InvService\ndatabase \&quot;:CSDL\&quot; as DB\n\nNS -&gt; UI: Nhap Chan doan &amp; Chon danh sach Dich vu\nUI -&gt; RecordService: createMedicalRecord(appointmentId, diagnosis, services)\nRecordService -&gt; DB: INSERT MedicalRecord\nDB --&gt; RecordService: recordId\n\nRecordService -&gt; InvService: generateInvoice(recordId, services)\nInvService -&gt; InvService: self.initInvoice()\n\nloop [cho moi dich vu da thuc hien]\nInvService -&gt; InvService: calculateLineTotal(quantity, price)\nInvService -&gt; DB: INSERT InvoiceDetail\nend\n\nInvService -&gt; InvService: calculateTotalAmount()\nInvService -&gt; DB: INSERT Invoice (totalAmount, status=&#39;UNPAID&#39;)\nDB --&gt; InvService: invoiceId\n\nInvService --&gt; RecordService: Invoice Generated\nRecordService --&gt; UI: Hoan tat Ho so &amp; Hoa don\nUI --&gt; NS: Hien thi ket qua luu thanh cong\n\nopt [Benh nhan yeu cau in hoa don]\nNS -&gt; UI: Yeu cau in\nUI -&gt; InvService: printInvoice(invoiceId)\nInvService --&gt; UI: Render PDF/Print Stream\nend\n@enduml\n\n&#39; =========================================================\n&#39; 7. SEQUENCE DIAGRAM - HỦY LỊCH HẸN\n&#39; =========================================================\n@startuml Sequence_HuyLichHen\ntitle Sequence Diagram - Huy Lich Hen\nautonumber\nskinparam Style strictuml\nskinparam Monochrome true\n\nactor \&quot;:BenhNhan\&quot; as BN\nparticipant \&quot;:HuyLichUI\&quot; as UI\nparticipant \&quot;:AppointmentService\&quot; as AppService\ndatabase \&quot;:CSDL\&quot; as DB\n\nBN -&gt; UI: Yeu cau Huy lich (appointmentId)\nUI -&gt; AppService: cancelAppointment(appointmentId)\nAppService -&gt; DB: SELECT status FROM Appointment WHERE id = appointmentId\nDB --&gt; AppService: status\n\nalt [status == \&quot;PENDING\&quot; OR status == \&quot;CONFIRMED\&quot;]\nAppService -&gt; DB: UPDATE Appointment SET status = &#39;CANCELLED&#39;\nDB --&gt; AppService: Success\nAppService --&gt; UI: Cancel Success\nUI --&gt; BN: Thong bao \&quot;Huy lich thanh cong\&quot;\n\nAppService -[se-]-&gt; DB: triggerSMSNotification(dentistId, \&quot;Lich hen da bi huy\&quot;)\nelse [else (status == \&quot;COMPLETED\&quot; hoac khac)]\nAppService --&gt; UI: Cancel Failed\nUI --&gt; BN: Báo lỗi \&quot;Lich hen da kham, khong the huy\&quot;\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TDuIjm5KejaVBJby8jKj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
